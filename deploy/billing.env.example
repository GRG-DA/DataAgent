# DataAgent billing server — production environment (systemd EnvironmentFile).
#
# Install:
#   sudo mkdir -p /etc/dataagent
#   sudo install -m 600 -o root -g root deploy/billing.env.example /etc/dataagent/billing.env
#   sudo nano /etc/dataagent/billing.env     # fill in values
#
# systemd reads these literally: no shell expansion, no $VARS, keep one
# KEY=value per line. Values with spaces (BILLING_EMAIL_FROM) are fine unquoted.
# Component readiness is visible any time at GET /healthz.

# ── Payment rail (ADR-016) ───────────────────────────────────────────
# Which checkout rail is LIVE: "famgateway" (UPI, free, no KYC — the
# rail data-agent.me runs), "razorpay" (dormant fallback, needs KYC +
# the Subscriptions capability), or "off" (kill-switch: /create-order
# returns 503 while webhooks keep answering read-only).
# Razorpay is the default so existing deployments keep their behaviour
# after an upgrade; set famgateway explicitly when you go live.
PAYMENTS_PROVIDER=famgateway

# ── Split-origin storefront (website on Vercel) ──────────────────────
# Origins allowed to call this API from the browser. Comma-separated,
# exact scheme + host, no trailing slash. Leave unset to use the shipped
# production defaults (https://data-agent.me, https://www.data-agent.me).
# BILLING_CORS_ORIGINS=https://data-agent.me,https://www.data-agent.me

# ── Keyless mode ────────────────────────────────────────────────────
# 1 = this server holds no license signing key: /healthz counts as ready,
# and central login succeeds without minting a session token. The desktop
# app applies the tokenless entitlement plan locally. Set 0 (or omit) when
# LICENSE_PRIVATE_KEY / LICENSE_PRIVATE_KEY_PATH is configured.
BILLING_KEYLESS=1

# ── FamGateway (famgateway.in) — UPI one-time payments ───────────────
# Merchant API key from the FamGateway dashboard. This key signs the
# checkout API calls AND verifies the webhook signature (HMAC-SHA256
# over the raw body), so treat it like a password.
FAMGATEWAY_API_KEY=
# Webhook endpoint: register it in the FamGateway dashboard as webhook_url:
#   https://pay.data-agent.me/famgateway/webhook
# (see docs/deployment/billing-server.md §FamGateway).
FAMGATEWAY_WEBHOOK_URL=
# Optional strict mode (ADR-016 §2c): refuse verify-order verdicts that
# carry no order_id at all. Leave empty until you've confirmed the live
# verify-order responses always include it — the /admin/reconcile sweep
# still recovers those payments either way.
FAMGATEWAY_STRICT_VERDICT=
# Optional redirect after hosted checkout (redirect_url). When unset the
# server uses BILLING_PUBLIC_URL below + /success.
FAMGATEWAY_REDIRECT_URL=
# Public base used to build the redirect URL when FAMGATEWAY_REDIRECT_URL
# is unset, e.g. https://pay.data-agent.me
BILLING_PUBLIC_URL=
# Storefront base used in account verification links.
# Defaults to https://data-agent.me.
BILLING_SITE_URL=

# ── Razorpay (dormant — kept for the fallback rail) ──────────────────
# Test keys (rzp_test_…) first; live keys (rzp_live_…) after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → create:
#   URL:    https://pay.data-agent.me/razorpay/webhook
#   Events: payment.captured, payment_link.paid, refund.processed,
#           subscription.authenticated, subscription.activated,
#           subscription.charged, subscription.pending, subscription.halted,
#           subscription.cancelled, subscription.completed, subscription.paused,
#           subscription.resumed, subscription.expired
RAZORPAY_WEBHOOK_SECRET=
# Printed by scripts/razorpay_create_plan.py (create the plan with the SAME
# mode keys as this server: test plan for test keys, live plan for live keys).
RAZORPAY_PLAN_ID_PRO=

# ── Entitlements API signing secret (openssl rand -hex 32) ──────────
# Must equal BILLING_SYNC_SECRET in the desktop app. Never reuse the
# Razorpay secrets here.
ENTITLEMENTS_SYNC_SECRET=

# ── License signing key: base64 of billing_server/keys/ed25519_private.pem ──
# Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("billing_server\keys\ed25519_private.pem"))
# Linux:   base64 -w0 billing_server/keys/ed25519_private.pem
# Using this variable means the .pem file itself never needs to exist on
# the server — keep the original backed up offline.
LICENSE_PRIVATE_KEY=

# ── Key-delivery email (Resend; optional — empty disables sending,
#    the success page still shows the key / activation state) ─────────
RESEND_API_KEY=
BILLING_EMAIL_FROM=DataAgent <billing@data-agent.me>
# Real, monitored reply address on the sending domain (never a freemail address,
# which trips SpamAssassin's FREEMAIL_FORGED_REPLYTO rule).
BILLING_EMAIL_REPLY_TO=DataAgent Support <billing@data-agent.me>

# ── Admin/support view + ops token (openssl rand -hex 24) ────────────
# Empty disables /admin/* entirely (fail-closed). Treat the URL as a secret.
# Ops endpoints (docs/deployment/billing-server.md §2c), cron-friendly:
#   POST /admin/reconcile      fail-safe sweep: grant orders the webhook never reached
#   POST /admin/expiry-nudge   daily — email D-3 reminders for 31-day Pro windows
#   POST /admin/orders/refund  revoke one order by hand (fam refunds are manual)
#   GET  /admin/webhook-failures   why did a buyer get no plan
BILLING_ADMIN_TOKEN=

# ── Hosted store (Turso/libSQL) — strongly recommended on a VPS ──────
# Orders/accounts/grants live in Turso instead of the local SQLite file,
# so the database survives rebuilds. Create at https://app.turso.tech —
# the token is shown once. Both lines set, or neither.
# TURSO_DATABASE_URL=libsql://dataagent-billing-<org>.aws-ap-south-1.turso.io
# TURSO_AUTH_TOKEN=

# ── SQLite fallback path (only used when TURSO_* is unset) ──────────
# Defaults to billing_server/billing.sqlite3 inside the app dir, which the
# unit above can write. Point it elsewhere only if you also create that dir:
#   BILLING_DB_PATH=/var/lib/dataagent-billing/billing.sqlite3
# BILLING_DB_PATH=
