# DataAgent — Caddy config for the billing VPS (Ubuntu/Debian, x86_64).
#
# Split origin (production): the storefront is hosted on Vercel at
# https://data-agent.me, and this hostname serves ONLY the billing API:
#
#   https://pay.data-agent.me/healthz       readiness
#   https://pay.data-agent.me/create-…      checkout JSON API → uvicorn
#   https://pay.data-agent.me/famgateway/*  webhook
#   https://pay.data-agent.me/v1/*          entitlements + accounts
#
# CORS is handled by billing_server (BILLING_CORS_ORIGINS), so the
# storefront may be on a different origin.
#
# TLS certificates are issued + renewed automatically (Let's Encrypt).
#
# Install:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# DNS: one A record pay.data-agent.me → the VPS IP. The apex belongs to
# Vercel; do not point the apex or www at this VM. Ports 80 + 443 must be
# reachable (Azure NSG + host firewall).

pay.data-agent.me {
	encode gzip

	# Baseline security headers. HSTS kicks in once TLS works; remove it only
	# if you ever need plain-HTTP fallback (you shouldn't for a billing site).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Paths mirror every @app route in billing_server/main.py.
	@api path /create-order* /create-subscription* /verify* /razorpay/* /famgateway/* /v1/* /admin/* /success* /healthz
	reverse_proxy @api 127.0.0.1:8090
}
