# DataAgent — production environment template.
# Copy to `.env` and fill. NEVER commit `.env`.
# Billing is intentionally excluded: checkout lives on a separate external
# site; self-hosted installs run fine with the built-in free plan + trial.

# ---- REQUIRED: session signing (min 16 chars, 64 hex recommended) ----
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
# Rotation: set a new value in .env and restart api + web
# (docker compose up -d --force-recreate api web). Old tokens invalidate
# on restart; revoked JTIs persist in config/revoked_jtis.json.
JWT_SECRET=

# ---- Network ----
APP_HOST=0.0.0.0
APP_PORT=8002
# Extra browser origins allowed to call the API (comma-separated or JSON list).
# Example: API_CORS_ORIGINS=https://analytics.example.com,https://www.example.com
API_CORS_ORIGINS=

# ---- Warehouse ----
DUCKDB_DATABASE_PATH=data/curated/warehouse.duckdb

# ---- Local LLM (Ollama default; empty = rule-based fallback still works) ----
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434

# ---- Cloud LLM keys (optional, empty = provider skipped) ----
LLM_OPENAI_KEY=
LLM_ANTHROPIC_KEY=
LLM_OPENROUTER_KEY=
LLM_GROQ_KEY=
LLM_GEMINI_KEY=
LLM_XAI_KEY=
LLM_DEEPSEEK_KEY=

# ---- Google OAuth for Gemini provider (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8002/auth/google/callback

# ---- Google Login to the app (optional; empty = local accounts only) ----
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8002/auth/google/login/callback

# ---- SSO (optional; empty = disabled) ----
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SAML_CERT=
SSO_SAML_KEY=

# ---- Billing (optional; empty = self-hosted free plan, checkout externally) ----
# BILLING_EXTERNAL_URL=https://billing.example.com
# BILLING_SYNC_URL=
# BILLING_SYNC_SECRET=

# ---- Rate limits (per-IP sliding window) ----
SECURITY_RATE_LIMIT_LOGIN_ATTEMPTS=10
SECURITY_RATE_LIMIT_REGISTER_ATTEMPTS=5
