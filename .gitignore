# Secrets & credentials
.jwt_secret
*.key
*.pem
!keygen_app/**/*.sql
# Firebase service-account keys (real secrets — never commit)
*-service-account.json
config/firebase-service-account.json
.env
.env.*
!/.env.example
billing_server/.env
# Billing server local order store (never commit purchase data)
billing_server/*.sqlite3
billing_server/*.sqlite3-*

# Local grant-signing material (see docs/BILLING.md). The signing key lives
# outside the warehouse on purpose — editing warehouse.duckdb must not grant
# a paid plan — so it must never be committed either.
data/.grant_key
data/.grant_migrated
# Revocation lists
revoked_jtis.json
config/revoked_jtis.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv-mcp/
.venv-laya/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
coverage.json
htmlcov/
htmlcov/

# Runtime data (generated by ETL/analytics)
# NOTE: analysis/ and export/ are SOURCE packages (analysis/*.py,
# export/pbix_export.py, export/BaseThemes/). Only their generated output is
# ignored below. Blanket-ignoring them left ~56 source files untracked, so a
# clone could not import the analysis layer or the Power BI export engine.
data/
logs/
outputs/
analysis/audit/

# Build & packaging artifacts
dist/
dist-verify2/
build/

# Local change backups
backups/

# Stray artefacts that used to sit at the repo root (see docs/LAUNCH-FIX-PLAN.md
# item R6). `out.html` was a stale copy of the SPA shell, `ollama` was a
# 0-byte file, `lib/` was an empty directory. All three are build noise.
/out.html
/ollama
/lib/

# Browser-automation scratch (Playwright MCP console logs + page snapshots)
.playwright-mcp/

# Graphify analysis cache
agent/graphify-out/
# The graphify knowledge graph is a regenerable tool artifact (~233 MB, mostly
# duplicate dated snapshots of the same graph). It is useful locally but is a
# liability in a repo whose pitch is "read the whole stack before you approve
# it" — a multi-hundred-MB clone is the first thing an evaluator hits.
# Regenerate with: graphify update .
graphify-out/
*.exe
*.msi
*.whl
*.zip
linux-install.zip
linux-install/
# Third-party binaries fetched at build time, never committed.
installers/opencode/

# Runtime config state (keep *.yaml config seeds)
config/users.json
config/db_connections.json
config/google_login_pending.json
config/google_login_pending/
config/llm_runtime.json
config/revoked_jtis.json

# Editor / OS
.vscode/*
!.vscode/mcp.json
.idea/
.vs/
*.suo
Thumbs.db
.DS_Store

# Agent harness internals
.ecc/
.hermes/
agentshield-reports/